# ============================================================
# 🤖 LINE 錄音檔推薦機器人 — 環境變數範本
# ------------------------------------------------------------
# 部署在 Render（或任何 PaaS）時，請把下列變數
# 逐一設定到該服務的 Environment 設定頁。
#
# ⚠️ 注意：這份清單跟根目錄的 .env.example 不同。
#    根目錄那份是給 GitHub Actions 上的「摘要機器人」用的，
#    兩者不可混用。
# ============================================================

# ── LINE（必填）─────────────────────────────────────────────
# LINE Developers Console → Messaging API 取得
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=

# ── Groq 免費 API（必填）────────────────────────────────────
# https://console.groq.com/keys
# 支援多把金鑰，用逗號分隔會自動輪換
GROQ_API_KEY=gsk_...
GROQ_MODEL=llama-3.3-70b-versatile

# ── Notion（必填）───────────────────────────────────────────
NOTION_TOKEN=secret_...
NOTION_DATABASE_ID=
# 第二個資料庫（選填，管理員專屬的「雙硬碟模式」才會用到）
NOTION_DATABASE_B_ID=

# ── Google Drive（必填，二擇一）──────────────────────────────
# PaaS 上沒有檔案系統可放金鑰檔，請把整份 JSON 內容貼進來
GOOGLE_SERVICE_ACCOUNT_JSON=
# 本機開發才用得到：金鑰檔路徑
GOOGLE_SERVICE_ACCOUNT_FILE=service_account.json

# ── 通關密碼（選填，但強烈建議設定）──────────────────────────
# 留空 = 任何人加好友就能查全部錄音檔
# 改動此密碼會讓「所有」已授權使用者需要重新輸入一次新密碼
BOT_PASSWORD=

# ── 授權名單持久化（設了 BOT_PASSWORD 就必填）────────────────
# ⚠️ 沒設 token 的話，授權名單只存在記憶體，
#    服務休眠或重新部署後，所有夥伴都要重打一次密碼。
#
# GitHub Personal Access Token，需要 repo 寫入權限：
# https://github.com/settings/tokens
SUMMARY_GITHUB_TOKEN=ghp_...
# 備用名稱，SUMMARY_GITHUB_TOKEN 沒設時會讀這個
# GITHUB_TOKEN=

# 授權名單存放的 repo（未設時預設為 TSAITZUNG-HUNG/Audio-file-summary）
GITHUB_REPO=TSAITZUNG-HUNG/Audio-file-summary
GITHUB_BRANCH=main

# ── 其他 ────────────────────────────────────────────────────
# PaaS 通常會自動注入，本機測試才需要
# PORT=5000
